{
  "expo": {
    "name": "Eonward",
    "slug": "eonward",
    "scheme": "eonward",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-notifications"
    ],
    "android": {
      "package": "com.nishef.eonward",
      "permissions": [
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.nishef.eonward"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
